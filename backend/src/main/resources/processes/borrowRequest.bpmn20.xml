<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:flowable="http://flowable.org/bpmn"
  xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
  id="Definitions_BorrowRequest"
  targetNamespace="http://flowable.org/processdef">
  <bpmn2:process id="borrowRequest" name="Borrow Request Workflow" isExecutable="true">
    <bpmn2:startEvent id="StartEvent_BorrowRequest" name="Start" />
    <bpmn2:userTask
      id="approveDemandTask"
      name="Demand Approval"
      flowable:assignee="${demandApproverId}" />
    <bpmn2:exclusiveGateway id="Gateway_AfterDemandApproval" name="Approval Decision" default="Flow_B2" />
    <bpmn2:userTask
      id="reviewDemandTask"
      name="Demand Review"
      flowable:assignee="${demandReviewerId}" />
    <bpmn2:exclusiveGateway id="Gateway_AfterDemandReview" name="Review Decision" default="Flow_B2C" />
    <bpmn2:userTask
      id="applicantReapplyTask"
      name="Applicant Reapply"
      flowable:assignee="${applicantId}" />
    <bpmn2:userTask
      id="analyzeDemandTask"
      name="Demand Analysis"
      flowable:assignee="${demandAnalystId}" />
    <bpmn2:exclusiveGateway id="Gateway_AfterAnalysis" name="Split Decision" default="Flow_B3B" />
    <bpmn2:userTask
      id="lendApproveTask"
      name="Lending Approval"
      flowable:assignee="${lendingApproverId}" />
    <bpmn2:exclusiveGateway id="Gateway_AfterLendingApproval" name="Split Handling Decision" default="Flow_B4B" />
    <bpmn2:userTask
      id="handleBorrowTask"
      name="Borrow Handling"
      flowable:assignee="${handlerId}" />
    <bpmn2:exclusiveGateway id="Gateway_AfterHandling" name="Receipt Decision" default="Flow_B5B" />
    <bpmn2:userTask
      id="receiveBorrowTask"
      name="Applicant Receipt"
      flowable:assignee="${applicantId}" />
    <bpmn2:endEvent id="EndEvent_HandlingSplitFinished" name="Handling Split Finished" />
    <bpmn2:endEvent id="EndEvent_SplitFinished" name="Split Finished" />
    <bpmn2:endEvent id="EndEvent_BorrowRequest" name="End" />
    <bpmn2:sequenceFlow id="Flow_B1" sourceRef="StartEvent_BorrowRequest" targetRef="approveDemandTask" />
    <bpmn2:sequenceFlow id="Flow_B1A" sourceRef="approveDemandTask" targetRef="Gateway_AfterDemandApproval" />
    <bpmn2:sequenceFlow id="Flow_B1B" sourceRef="Gateway_AfterDemandApproval" targetRef="applicantReapplyTask">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression"><![CDATA[${rejected}]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_B2" sourceRef="Gateway_AfterDemandApproval" targetRef="reviewDemandTask" />
    <bpmn2:sequenceFlow id="Flow_B2A" sourceRef="reviewDemandTask" targetRef="Gateway_AfterDemandReview" />
    <bpmn2:sequenceFlow id="Flow_B2B" sourceRef="Gateway_AfterDemandReview" targetRef="applicantReapplyTask">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression"><![CDATA[${rejected}]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_B2C" sourceRef="Gateway_AfterDemandReview" targetRef="analyzeDemandTask" />
    <bpmn2:sequenceFlow id="Flow_B2D" sourceRef="applicantReapplyTask" targetRef="approveDemandTask" />
    <bpmn2:sequenceFlow id="Flow_B3" sourceRef="analyzeDemandTask" targetRef="Gateway_AfterAnalysis" />
    <bpmn2:sequenceFlow id="Flow_B3A" sourceRef="Gateway_AfterAnalysis" targetRef="EndEvent_SplitFinished">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression"><![CDATA[${splitCreated}]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_B3R" sourceRef="Gateway_AfterAnalysis" targetRef="applicantReapplyTask">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression"><![CDATA[${rejected}]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_B3B" sourceRef="Gateway_AfterAnalysis" targetRef="lendApproveTask" />
    <bpmn2:sequenceFlow id="Flow_B4" sourceRef="lendApproveTask" targetRef="Gateway_AfterLendingApproval" />
    <bpmn2:sequenceFlow id="Flow_B4R" sourceRef="Gateway_AfterLendingApproval" targetRef="analyzeDemandTask">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression"><![CDATA[${rejected}]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_B4A" sourceRef="Gateway_AfterLendingApproval" targetRef="EndEvent_HandlingSplitFinished">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression"><![CDATA[${handlingSplitCreated}]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_B4B" sourceRef="Gateway_AfterLendingApproval" targetRef="handleBorrowTask" />
    <bpmn2:sequenceFlow id="Flow_B5" sourceRef="handleBorrowTask" targetRef="Gateway_AfterHandling" />
    <bpmn2:sequenceFlow id="Flow_B5A" sourceRef="Gateway_AfterHandling" targetRef="receiveBorrowTask">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression"><![CDATA[${action == '借出'}]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_B5B" sourceRef="Gateway_AfterHandling" targetRef="EndEvent_BorrowRequest" />
    <bpmn2:sequenceFlow id="Flow_B6" sourceRef="receiveBorrowTask" targetRef="EndEvent_BorrowRequest" />
  </bpmn2:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_BorrowRequest">
    <bpmndi:BPMNPlane id="BPMNPlane_BorrowRequest" bpmnElement="borrowRequest">
      <bpmndi:BPMNShape id="StartEvent_BorrowRequest_di" bpmnElement="StartEvent_BorrowRequest">
        <dc:Bounds x="120" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approveDemandTask_di" bpmnElement="approveDemandTask">
        <dc:Bounds x="220" y="98" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reviewDemandTask_di" bpmnElement="reviewDemandTask">
        <dc:Bounds x="390" y="98" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="applicantReapplyTask_di" bpmnElement="applicantReapplyTask">
        <dc:Bounds x="455" y="18" width="120" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="analyzeDemandTask_di" bpmnElement="analyzeDemandTask">
        <dc:Bounds x="560" y="98" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AfterAnalysis_di" bpmnElement="Gateway_AfterAnalysis" isMarkerVisible="true">
        <dc:Bounds x="705" y="113" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lendApproveTask_di" bpmnElement="lendApproveTask">
        <dc:Bounds x="810" y="98" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AfterLendingApproval_di" bpmnElement="Gateway_AfterLendingApproval" isMarkerVisible="true">
        <dc:Bounds x="955" y="113" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="handleBorrowTask_di" bpmnElement="handleBorrowTask">
        <dc:Bounds x="1060" y="98" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AfterHandling_di" bpmnElement="Gateway_AfterHandling" isMarkerVisible="true">
        <dc:Bounds x="1225" y="113" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="receiveBorrowTask_di" bpmnElement="receiveBorrowTask">
        <dc:Bounds x="1330" y="98" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_HandlingSplitFinished_di" bpmnElement="EndEvent_HandlingSplitFinished">
        <dc:Bounds x="1060" y="220" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_SplitFinished_di" bpmnElement="EndEvent_SplitFinished">
        <dc:Bounds x="810" y="220" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_BorrowRequest_di" bpmnElement="EndEvent_BorrowRequest">
        <dc:Bounds x="1440" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_B1_di" bpmnElement="Flow_B1">
        <di:waypoint x="156" y="138" />
        <di:waypoint x="220" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B2_di" bpmnElement="Flow_B2">
        <di:waypoint x="330" y="138" />
        <di:waypoint x="390" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B2A_di" bpmnElement="Flow_B2A">
        <di:waypoint x="500" y="138" />
        <di:waypoint x="560" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B3_di" bpmnElement="Flow_B3">
        <di:waypoint x="670" y="138" />
        <di:waypoint x="705" y="133" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B3A_di" bpmnElement="Flow_B3A">
        <di:waypoint x="725" y="153" />
        <di:waypoint x="725" y="238" />
        <di:waypoint x="810" y="238" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B3R_di" bpmnElement="Flow_B3R">
        <di:waypoint x="725" y="113" />
        <di:waypoint x="725" y="52" />
        <di:waypoint x="515" y="52" />
        <di:waypoint x="515" y="98" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B3B_di" bpmnElement="Flow_B3B">
        <di:waypoint x="745" y="133" />
        <di:waypoint x="810" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B4_di" bpmnElement="Flow_B4">
        <di:waypoint x="920" y="138" />
        <di:waypoint x="955" y="133" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B4A_di" bpmnElement="Flow_B4A">
        <di:waypoint x="975" y="153" />
        <di:waypoint x="975" y="238" />
        <di:waypoint x="1060" y="238" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B4B_di" bpmnElement="Flow_B4B">
        <di:waypoint x="995" y="133" />
        <di:waypoint x="1060" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B5_di" bpmnElement="Flow_B5">
        <di:waypoint x="1170" y="138" />
        <di:waypoint x="1225" y="133" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B5A_di" bpmnElement="Flow_B5A">
        <di:waypoint x="1265" y="133" />
        <di:waypoint x="1330" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B5B_di" bpmnElement="Flow_B5B">
        <di:waypoint x="1245" y="153" />
        <di:waypoint x="1245" y="238" />
        <di:waypoint x="1440" y="238" />
        <di:waypoint x="1440" y="156" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B6_di" bpmnElement="Flow_B6">
        <di:waypoint x="1450" y="138" />
        <di:waypoint x="1440" y="138" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>
